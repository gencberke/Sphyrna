+    /// True when `line` renders exactly as this snapshot copy: same cells,
+    /// width and line flags. Rows with grapheme clusters or payload atoms
+    /// (hyperlinks) never match: their packed cell only references arena
+    /// content, so equal cells would not prove equal text. Lets a frame skip
+    /// rows an application rewrote with identical content.
+    func snapshotRendersLike (_ line: BufferLine) -> Bool
+    {
+        guard line !== self, storage.count == line.storage.count,
+              isWrapped == line.isWrapped, renderMode == line.renderMode,
+              bidiStateValue == line.bidiStateValue else {
+            return false
+        }
+        for index in 0..<storage.count {
+            let cell = storage.rawCell(at: index)
+            guard cell == line.storage.rawCell(at: index),
+                  cell.contentTag != .grapheme, cell.payloadCode == 0 else {
+                return false
+            }
+        }
+        return true
     }
 
