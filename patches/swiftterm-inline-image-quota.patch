+    /// Inline images in attach order, for the per-screen quota. Entries whose
+    /// image already left its line (overwritten, cleared, recycled) are
+    /// skipped when reached; identity, not line position, decides removal.
+    private struct StoredInlineImage {
+        weak var line: BufferLine?
+        weak var image: AnyObject?
+        let bytes: Int
+    }
+    private var storedInlineImages: [StoredInlineImage] = []
+    private var storedInlineImagesHead = 0
+    private var storedInlineImageBytes = 0
     
