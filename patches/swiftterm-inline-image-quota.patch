@@ -260,6 +272,41 @@ public final class Buffer {
         if !hadImages {
             _linesWithImagesCount += 1
         }
+        enforceInlineImageQuota(adding: image, to: line)
+    }
+
+    private func enforceInlineImageQuota(adding image: TerminalImage, to line: BufferLine) {
+        guard let options = terminal?.options,
+              options.inlineImageStorageLimitBytesPerScreen != nil
+                || options.inlineImageLimitPerScreen != nil else { return }
+        // Reported sizes are truncated while bitmaps are built from the
+        // ceiling (MacTerminalView.bitmapContext); +1 keeps this an upper bound.
+        let bytes = (max(0, image.pixelWidth) + 1) * (max(0, image.pixelHeight) + 1) * 4
+        storedInlineImages.append(StoredInlineImage(line: line, image: image as AnyObject, bytes: bytes))
+        storedInlineImageBytes += bytes
+        let byteLimit = options.inlineImageStorageLimitBytesPerScreen ?? .max
+        let countLimit = options.inlineImageLimitPerScreen ?? .max
+        while storedInlineImagesHead < storedInlineImages.count,
+              storedInlineImageBytes > byteLimit
+                || storedInlineImages.count - storedInlineImagesHead > countLimit {
+            let oldest = storedInlineImages[storedInlineImagesHead]
+            storedInlineImagesHead += 1
+            storedInlineImageBytes -= oldest.bytes
+            guard let owner = oldest.line, let target = oldest.image,
+                  var images = owner.images,
+                  let position = images.firstIndex(where: { ($0 as AnyObject) === target }) else { continue }
+            images.remove(at: position)
+            if images.isEmpty {
+                owner.images = nil
+                _linesWithImagesCount -= 1
+            } else {
+                owner.images = images
+            }
+        }
+        if storedInlineImagesHead > 1_024, storedInlineImagesHead * 2 > storedInlineImages.count {
+            storedInlineImages.removeFirst(storedInlineImagesHead)
+            storedInlineImagesHead = 0
+        }
     }
 
