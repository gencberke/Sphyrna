{
  "label": "CP2 Claude reopen after active quit",
  "actions": [
    {
      "op": "launch",
      "provider": "claude",
      "hooks": true,
      "resumeSessionID": "8AAC4338-24FA-4781-AE5E-A5D0D6751BA0",
      "arguments": ["--model", "haiku", "--effort", "low", "--no-chrome"]
    },
    { "op": "wait", "seconds": 3 },
    { "op": "write", "text": "\r" },
    { "op": "hook-expect", "events": ["SessionStart"], "seconds": 5 },
    {
      "op": "write",
      "text": "What exact all-caps token did you reply with in the completed turn immediately before the interrupted tool-request turn? Reply with only that token. Do not use tools."
    },
    { "op": "wait", "seconds": 0.3 },
    { "op": "write", "text": "\r" },
    {
      "op": "hook-expect",
      "events": ["UserPromptSubmit", "Stop"],
      "seconds": 15
    },
    { "op": "quit" }
  ]
}
