{
  "label": "C2 SIGHUP and C3 active Quit",
  "actions": [
    {
      "op": "launch",
      "provider": "claude",
      "arguments": [
        "--model",
        "haiku",
        "--effort",
        "low",
        "--no-chrome"
      ]
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "write",
      "text": "Run exactly sleep 120 using Bash with run_in_background=true, then reply READY. Do not run any other commands."
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 8
    },
    {
      "op": "snapshot",
      "label": "background-running"
    },
    {
      "op": "write",
      "text": "Compute the first 500 prime numbers silently, then say DONE. Keep the existing background job running."
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "snapshot",
      "label": "active-turn-and-background"
    },
    {
      "op": "quit"
    }
  ]
}
