{
  "label": "CP2 Claude clear creates a new provider conversation",
  "actions": [
    {
      "op": "launch",
      "provider": "claude",
      "hooks": true,
      "arguments": [
        "--model",
        "haiku",
        "--effort",
        "low",
        "--no-chrome"
      ]
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "hook-expect",
      "events": ["SessionStart"],
      "seconds": 5
    },
    {
      "op": "write",
      "text": "/clear"
    },
    {
      "op": "wait",
      "seconds": 0.2
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "quit"
    }
  ]
}
