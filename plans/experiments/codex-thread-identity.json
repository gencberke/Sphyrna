{
  "label": "CP2 Codex remote TUI identity and new conversation",
  "actions": [
    {
      "op": "launch",
      "slot": "server",
      "provider": "codex",
      "route": "server"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "rpc-connect",
      "slot": "rpc"
    },
    {
      "op": "launch",
      "slot": "tui",
      "provider": "codex",
      "route": "remote",
      "arguments": [
        "-m",
        "gpt-6-luna",
        "-c",
        "model_reasoning_effort=\"low\""
      ]
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "write",
      "slot": "tui",
      "text": "/new"
    },
    {
      "op": "wait",
      "seconds": 0.2
    },
    {
      "op": "write",
      "slot": "tui",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "quit"
    }
  ]
}
