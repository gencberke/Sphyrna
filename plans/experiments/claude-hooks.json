{
  "label": "Claude hook identity and turn state",
  "actions": [
    {
      "op": "launch",
      "provider": "claude",
      "hooks": true,
      "arguments": [
        "--model",
        "haiku",
        "--effort",
        "low",
        "--no-chrome",
        "--debug-file",
        "${run}/claude-debug.txt"
      ]
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "hook-expect",
      "events": ["SessionStart"],
      "seconds": 5
    },
    {
      "op": "write",
      "text": "Reply exactly HOOK_OK. Do not use tools."
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "hook-expect",
      "events": ["UserPromptSubmit", "Stop"],
      "seconds": 15
    },
    {
      "op": "quit"
    }
  ]
}
