{
  "label": "CP2 Codex remote resume existing thread",
  "actions": [
    {
      "op": "launch",
      "slot": "server",
      "provider": "codex",
      "route": "server"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "rpc-connect",
      "slot": "rpc"
    },
    {
      "op": "launch",
      "slot": "tui",
      "provider": "codex",
      "route": "remote",
      "threadID": "01a0e414-6e51-7d43-a3b3-e9e5ea72d53e",
      "arguments": [
        "-m",
        "gpt-6-luna",
        "-c",
        "model_reasoning_effort=\"low\""
      ]
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "write",
      "slot": "tui",
      "text": "Reply exactly CODEX_RESUME_OK. Do not use tools."
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "write",
      "slot": "tui",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 10
    },
    {
      "op": "rpc-request",
      "slot": "rpc",
      "method": "thread/loaded/list",
      "params": {},
      "save": "loaded-threads"
    },
    {
      "op": "quit"
    }
  ]
}
