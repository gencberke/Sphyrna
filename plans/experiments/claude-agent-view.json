{
  "label": "C5 Agent View enabled isolated control",
  "actions": [
    {
      "op": "launch",
      "provider": "claude",
      "agentView": true,
      "arguments": [
        "--model",
        "haiku",
        "--effort",
        "low",
        "--no-chrome"
      ]
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "write",
      "text": "Run exactly sleep 120 using Bash with run_in_background=true, then reply READY. Do not run any other commands."
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 8
    },
    {
      "op": "snapshot",
      "label": "agent-view-background"
    },
    {
      "op": "write",
      "text": "/exit"
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "write",
      "text": "\r"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "snapshot",
      "label": "agent-view-after-exit"
    },
    {
      "op": "control",
      "seconds": 90
    }
  ]
}
