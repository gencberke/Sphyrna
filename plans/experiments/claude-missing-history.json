{
  "label": "CP2 Claude missing resume history",
  "actions": [
    {
      "op": "launch",
      "provider": "claude",
      "hooks": true,
      "resumeSessionID": "00000000-0000-4000-8000-000000000001",
      "arguments": ["--model", "haiku", "--effort", "low", "--no-chrome"]
    },
    { "op": "wait", "seconds": 5 },
    { "op": "quit" }
  ]
}
